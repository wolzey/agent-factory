{
  "name": "agent-factory",
  "version": "1.0.0",
  "description": "2D pixel art visualization of Claude Code agent sessions",
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/agent-factory"
    ]
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"tsx watch server/index.ts\" \"vite dev\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite dev",
    "test": "vitest run --config vitest.config.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "install-hooks": "bash hooks/install.sh"
  },
  "keywords": [
    "claude-code",
    "visualization",
    "pixel-art",
    "agents",
    "pi-package"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "@libsql/client": "^0.18.0",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "concurrently": "^9.2.1",
    "jsfxr": "^1.4.0",
    "phaser": "^3.90.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "ws": "8.21.0",
      "brace-expansion": "5.0.9"
    }
  }
}
